public class PayrollApp {
    public static void main(String[] args) {
        
        Employee emp = new Employee("Alice Smith", 50000.0);
        Employee mgr = new Manager("Bob Jones", 80000.0, 15000.0);

        
        System.out.println("Employee: " + emp.getName());
        System.out.println("Calculated Salary: $" + emp.calculateSalary());
        System.out.println();

        System.out.println("Manager: " + mgr.getName());
        System.out.println("Calculated Salary: $" + mgr.calculateSalary());
        System.out.println();


        System.out.println("Employee (" + emp.getName() + ") with 10 overtime hours:");
        System.out.println("Total Salary: $" + emp.calculateSalary(10));
    }
}